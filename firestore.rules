rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tetapan app (musim ranking)
    match /config/{doc} {
      allow read: if true;
      // Reset ranking dari app: mesti tulis dokumen resets/<password>-<musim> dalam batch yang sama
      allow create, update: if request.auth != null && doc == 'app'
                            && request.resource.data.season is int
                            && existsAfter(/databases/$(database)/documents/resets/$('prokuiz2026-' + string(request.resource.data.season)));
    }

    // Log reset. Password admin hanya ada di sini (rules), bukan dalam kod app.
    match /resets/{id} {
      allow read: if false;
      allow create: if request.auth != null && id.matches('prokuiz2026-[0-9]+');
    }

    // Profil & ranking pemain — semua boleh baca, hanya pemilik boleh tulis
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 14
                   && request.resource.data.rating is int
                   && request.resource.data.rating < 5000;
    }

    // Perlawanan 1v1
    match /matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.p1.uid == request.auth.uid;
      allow update: if request.auth != null && (
                       resource.data.p1.uid == request.auth.uid
                    || (resource.data.p2 != null && resource.data.p2.uid == request.auth.uid)
                    || (resource.data.p2 == null && request.resource.data.p2.uid == request.auth.uid));
      allow delete: if request.auth != null && resource.data.p1.uid == request.auth.uid;
    }
  }
}
